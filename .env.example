# Supabase (proyecto AgroTabaco) → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave secreta (service_role / secret key). Solo en el servidor: nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket privado donde se guardan los archivos (<id-solicitud>/<documento>/, igual que agrotabaco.com)
SUPABASE_BUCKET=documentacion

# Clave de Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email(s) que reciben las solicitudes, separados por coma
SOLICITUDES_EMAIL_TO=tuemail@ejemplo.com

# Remitente: email de un dominio verificado en Resend (el nombre "AgroTabaco" se agrega solo).
SOLICITUDES_EMAIL_FROM=solicitudes@agrotabaco-labs.com
